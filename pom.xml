<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>org.sonarqube.l10n.fr</groupId>
	<artifactId>sonar-l10n-fr-plugin</artifactId>
	<version>{revision}</version>
	<packaging>sonar-plugin</packaging>

	<name>French Pack for SonarQube</name>
	<description>Language Pack for French</description>
	<url>https://github.com/Sonar-l10n-FR/sonar-l10n-fr</url>
	<inceptionYear>2011</inceptionYear>
	<licenses>
		<license>
			<name>GNU LGPL 3</name>
			<url>https://www.gnu.org/licenses/lgpl-3.0.txt</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<contributors>
		<contributor>
			<name>Baptiste Mathus</name>
			<organizationUrl>http://batmat.net</organizationUrl>
		</contributor>
		<contributor>
			<name>Fabrice Bellingard</name>
			<organization>SonarSource</organization>
			<organizationUrl>http://sonarsource.com</organizationUrl>
		</contributor>
		<contributor>
			<name>Simon Brandhof</name>
			<organization>SonarSource</organization>
			<organizationUrl>http://sonarsource.com</organizationUrl>
		</contributor>
		<contributor>
			<name>David Festal</name>
			<organizationUrl>http://serli.com</organizationUrl>
		</contributor>
		<contributor>
			<name>Zoé THIVET</name>
			<organizationUrl>https://github.com/ZoeThivet</organizationUrl>
		</contributor>
		<contributor>
			<name>jycr</name>
			<organizationUrl>https://github.com/jycr</organizationUrl>
		</contributor>
		<contributor>
			<name>Greenystuff</name>
			<organizationUrl>https://github.com/Greenystuff</organizationUrl>
		</contributor>
	</contributors>

	<scm>
		<connection>scm:git:https://github.com/Sonar-l10n-FR/sonar-l10n-fr.git</connection>
		<developerConnection>scm:git:git@github.com:Sonar-l10n-FR/sonar-l10n-fr.git</developerConnection>
		<url>https://github.com/Sonar-l10n-FR/sonar-l10n-fr</url>
		<tag>HEAD</tag>
	</scm>
	<issueManagement>
		<system>GitHub</system>
		<url>https://github.com/Sonar-l10n-FR/sonar-l10n-fr/issues</url>
	</issueManagement>

	<properties>
		<!-- This is only the default for local development, CI will override it! -->
		<revision>develop-SNAPSHOT</revision>

		<sonar.pluginClass>org.sonar.plugins.l10n.FrenchPackPlugin</sonar.pluginClass>
		<sonar.version>26.10.0.133078</sonar.version>
		<!-- The API shipped by the targeted server, so the build fails here rather than at
		     runtime if something this pack uses ever leaves the public API. -->
		<sonar.plugin.api.version>14.1.0.5543</sonar.plugin.api.version>
		<!-- Written to the Sonar-Version manifest header, which the server reads as a
		     MINIMUM: it refuses to start when its own plugin API is older. Left unset,
		     sonar-packaging-maven-plugin copies the compile version there instead, which
		     would lock the pack to 26.10 and later for no reason - it only implements
		     org.sonar.api.Plugin, unchanged for years. 9.14.0.375 is what the published
		     10.0.0 declares, and what makes the Marketplace range [24.12,LATEST] hold. -->
		<sonar.plugin.api.min.version>9.14.0.375</sonar.plugin.api.min.version>

		<maven.build.timestamp.format>yyyy-MM-dd'T'HH:mm:ss.SSSZ</maven.build.timestamp.format>
		<!--suppress UnresolvedMavenProperty -->
		<project.build.outputTimestamp>${git.commit.timestamp.datetime}</project.build.outputTimestamp>

		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.source>17</maven.compiler.source>
		<maven.compiler.target>17</maven.compiler.target>
		<maven.compiler.release>17</maven.compiler.release>

		<sonar.organization>sonar-l10n-fr</sonar.organization>
		<sonar.host.url>https://sonarcloud.io</sonar.host.url>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.sonarsource.api.plugin</groupId>
			<artifactId>sonar-plugin-api</artifactId>
			<version>${sonar.plugin.api.version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.sonarsource.sonarqube</groupId>
			<artifactId>sonar-testing-harness</artifactId>
			<version>${sonar.version}</version>
			<scope>test</scope>
		</dependency>
		<!-- SonarRuntimeImpl and PluginContextImpl used to live in org.sonar.api.internal
		     inside sonar-plugin-api. They were dropped from the public API and now ship
		     here. Only those two classes are needed, so the transitive tree is excluded. -->
		<dependency>
			<groupId>org.sonarsource.sonarqube</groupId>
			<artifactId>sonar-plugin-api-impl</artifactId>
			<version>${sonar.version}</version>
			<scope>test</scope>
			<exclusions>
				<exclusion>
					<groupId>*</groupId>
					<artifactId>*</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>org.assertj</groupId>
			<artifactId>assertj-core</artifactId>
			<version>3.27.7</version>
			<scope>test</scope>
		</dependency>
		<!-- Used by SettingsKeys to read /api/settings/list_definitions. It already comes in
		     transitively through sonar-core, but a tool should not depend on that by accident. -->
		<dependency>
			<groupId>com.google.code.gson</groupId>
			<artifactId>gson</artifactId>
			<version>2.14.0</version>
			<scope>test</scope>
		</dependency>
		<!-- Also translated by this language pack: the Clean as You Code plugin ships its
		     own bundle, org/sonar/l10n/cayc.properties, and this pack now carries
		     cayc_fr.properties for it. I18nMatchers requires the default bundle on the
		     classpath to check the translation is in sync, which is exactly the point of
		     declaring it here. 26.10 no longer bundles this plugin; the version is the last
		     one bundled, 26.9's, which servers up to 26.9 still run. -->
		<dependency>
			<groupId>org.sonarsource.plugins.cayc</groupId>
			<artifactId>sonar-cayc-plugin</artifactId>
			<version>2.6.0.3665</version>
			<scope>test</scope>
			<exclusions>
				<exclusion>
					<groupId>*</groupId>
					<artifactId>*</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<!-- Same reason as the Clean as You Code plugin above: the PHP analyzer ships
		     org/sonar/l10n/php.properties, which carries the labels of its rule
		     parameters, and this pack now translates them in php_fr.properties.
		     Version pinned to the one bundled in sonar.version. -->
		<dependency>
			<groupId>org.sonarsource.php</groupId>
			<artifactId>sonar-php-plugin</artifactId>
			<version>4.1.0.16998</version>
			<scope>test</scope>
			<exclusions>
				<exclusion>
					<groupId>*</groupId>
					<artifactId>*</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<!-- Dependencies which are translated by this language pack.
		     Only one file is used from this artifact: org/sonar/l10n/core.properties, the
		     reference bundle the tests compare core_fr.properties against. None of its code
		     is executed, so the whole transitive tree is excluded. That is not just a
		     build-time saving: since 26.x, sonar-core depends on org.sonarsource.sonarqube:
		     sonar-sarif, which is NOT published to Maven Central, so the build cannot
		     resolve it at all without this exclusion. -->
		<dependency>
			<groupId>org.sonarsource.sonarqube</groupId>
			<artifactId>sonar-core</artifactId>
			<version>${sonar.version}</version>
			<scope>test</scope>
			<exclusions>
				<exclusion>
					<groupId>*</groupId>
					<artifactId>*</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
	</dependencies>

	<build>
		<resources>
			<resource>
				<directory>src/main/resources</directory>
				<excludes>
					<exclude>**/core.properties</exclude>
				</excludes>
				<filtering>false</filtering>
			</resource>
		</resources>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<version>3.16.0</version>
				</plugin>

				<plugin>
					<groupId>me.qoomon</groupId>
					<artifactId>maven-git-versioning-extension</artifactId>
					<version>9.12.1</version>
				</plugin>
			</plugins>
		</pluginManagement>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.6.0</version>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-clean-plugin</artifactId>
				<version>3.5.0</version>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-install-plugin</artifactId>
				<version>3.1.4</version>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-site-plugin</artifactId>
				<version>3.22.0</version>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
				<version>3.5.0</version>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-deploy-plugin</artifactId>
				<version>3.1.4</version>
			</plugin>
			<plugin>
				<groupId>org.sonarsource.sonar-packaging-maven-plugin</groupId>
				<artifactId>sonar-packaging-maven-plugin</artifactId>
				<version>1.25.1.3002</version>
				<extensions>true</extensions>
				<configuration>
					<!-- No basePlugin: since SonarQube 5.2 the server logs "This metadata can be
					     removed from manifest of l10n plugins" when it is present. -->
					<pluginName>French Pack</pluginName>
					<pluginDescription>Language pack for French</pluginDescription>
					<!-- Sonar-Version = firstNonNull(pluginApiMinVersion, sonar-plugin-api version).
					     Set explicitly so that compiling against a newer API never narrows the range
					     of servers able to load the pack. -->
					<pluginApiMinVersion>${sonar.plugin.api.min.version}</pluginApiMinVersion>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>native2ascii-maven-plugin</artifactId>
				<version>2.1.1</version>
				<executions>
					<execution>
						<goals>
							<goal>inplace</goal>
						</goals>
						<configuration>
							<dir>${project.build.outputDirectory}</dir>
							<encoding>ISO-8859-1</encoding>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<version>3.6.3</version>
				<executions>
					<execution>
						<id>enforce-distribution-size</id>
						<goals>
							<goal>enforce</goal>
						</goals>
						<phase>verify</phase>
						<configuration>
							<rules>
								<requireMavenVersion>
									<version>3.8.7</version>
								</requireMavenVersion>
								<requireFilesSize>
									<minsize>95000</minsize>
									<maxsize>400000</maxsize>
									<files>
										<file>${project.build.directory}/${project.artifactId}-${project.version}.jar</file>
									</files>
								</requireFilesSize>
								<reactorModuleConvergence/>
								<requirePluginVersions/>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.15</version>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>prepare-package</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
	<profiles>
		<profile>
			<!-- Regenerates core_fr.properties from the reference bundle. See BundleSync. -->
			<id>sync</id>
			<properties>
				<l10n.tool>org.sonar.plugins.l10n.BundleSync</l10n.tool>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>exec-maven-plugin</artifactId>
						<version>3.6.4</version>
						<configuration>
							<!-- Overridable, so the same profile can run the other tool:
							     -Dl10n.tool=org.sonar.plugins.l10n.WebappKeys -->
							<mainClass>${l10n.tool}</mainClass>
							<classpathScope>test</classpathScope>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>check</id>
			<properties>
				<profile.check>true</profile.check>
				<maven.test.skip>true</maven.test.skip>
				<maven.main.skip>true</maven.main.skip>
				<assembly.skipAssembly>true</assembly.skipAssembly>
				<dependency-check.skip>false</dependency-check.skip>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>versions-maven-plugin</artifactId>
						<version>2.15.0</version>
						<executions>
							<execution>
								<id>versions-check-updates</id>
								<phase>initialize</phase>
								<goals>
									<goal>display-parent-updates</goal>
									<goal>display-dependency-updates</goal>
									<goal>display-plugin-updates</goal>
									<goal>display-property-updates</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>tidy-maven-plugin</artifactId>
						<version>1.2.0</version>
						<executions>
							<execution>
								<phase>initialize</phase>
								<goals>
									<goal>pom</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-dependency-plugin</artifactId>
						<version>3.6.0</version>
						<executions>
							<execution>
								<id>dependency-analyze</id>
								<phase>initialize</phase>
								<goals>
									<goal>analyze-only</goal>
									<goal>analyze-dep-mgt</goal>
									<goal>analyze-duplicate</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
